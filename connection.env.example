# Plantilla de conexion para scripts locales.
# * NO incluir contrasenas reales: sobrescribir con .env o variables al ejecutar.
# * Copiar a connection.env (excluido por .gitignore) y definir al arrancar.
# * Referencia de uso: docker exec ... sqlplus core_dev/${ORACLE_DB_PASSWORD}@...
#
# Motor declarado en README: Oracle Database XE 21c (gvenzl/oracle-xe:21.3.0, PDB XEPDB1)
export ORACLE_PDB=XEPDB1
export ORACLE_HOST=localhost
export ORACLE_PORT=1521
export ORACLE_USER=core_dev
export ORACLE_DB_PASSWORD=<definir_en_local_no_commit>
